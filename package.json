{
  "name": "tv-screen-share",
  "version": "1.0.0",
  "private": true,
  "description": "Put your computer screen on a TV over Wi-Fi with no HDMI cable, using the TV's own browser. Works on 2016-era smart TVs.",
  "keywords": [
    "screen-sharing",
    "webrtc",
    "smart-tv",
    "philips",
    "saphi",
    "android-tv",
    "hdmi-alternative",
    "screen-mirroring",
    "legacy-browser",
    "no-build-step"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arhanbayram95-beep/Tv_screen_sharing.git"
  },
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "start:https": "node server.js --https",
    "cert": "node scripts/make-cert.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
